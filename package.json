{
  "name": "gateway-fastify",
  "version": "1.1.0",
  "main": "./dist/infrastructure/server.js",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\"",
    "preversion": "npx npm-run-all format lint",
    "clean": "rimraf ./lib",
    "build": "npx tsc --project tsconfig.json",
    "transpile": "npx npm-run-all clean build",
    "test": "env NODE_ENV=test jest",
    "test:dev": "env NODE_ENV=test jest --watch",
    "start": "node ./dist/infrastructure/server.js",
    "local": "nodemon --watch . --ext ts --exec ts-node src/infrastructure/server.ts",
    "postinstall": "npx npm-run-all transpile"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "CECOBAN gateway",
  "engines": {
    "node": "22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isaacfintec/gateway-fastify.git"
  },
  "homepage": "https://github.com/isaacfintec/gateway-fastify#readme",
  "bugs": {
    "url": "https://github.com/isaacfintec/gateway-fastify/issues"
  },
  "nodemonConfig": {
    "ignore": [
      "./dist",
      "./dist/**"
    ],
    "watch": [
      "./src/**"
    ],
    "ext": "js,json,mjs,ts,mock"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "npm-run-all": "^4.1.5",
    "prettier": "3.5.2",
    "rimraf": "^6.0.1",
    "standard": "^17.1.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.1",
    "axios": "1.7.9",
    "fastify": "5.2.1",
    "fastify-plugin": "5.0.1"
  }
}
